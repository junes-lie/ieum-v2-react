# IEUM V2는 유료 이미지·믹싱 API를 사용하지 않습니다.
# AI 추론 서비스용 환경변수는 없습니다. 아래는 협업 서버의 선택적 준비 설정입니다.

# Optional server Auth preparation. Empty values keep it disconnected.
# These are server-only: NEVER prefix with VITE_ or commit actual credentials.
# Set provider only after selection/access and actual session verification.
IEUM_AUTH_PROVIDER=
IEUM_SUPABASE_URL=
IEUM_SUPABASE_PUBLISHABLE_KEY=

# Optional Profile DB preparation. Apply the migration before enabling this.
IEUM_DB_PROVIDER=

# Optional SERVER-ONLY private Storage preparation. Never use VITE_ for this key.
IEUM_STORAGE_PROVIDER=
IEUM_SUPABASE_SECRET_KEY=
IEUM_AUDIO_BUCKET=

# Optional SERVER-ONLY real audio verification worker. Empty keeps it disconnected.
# Supply a compatible installed decoder path and operational decode-length bound.
# Never copy the local Windows runtime path into hosted Linux configuration.
IEUM_AUDIO_DECODER_PATH=
IEUM_AUDIO_MAX_DECODE_SECONDS=

# Optional SERVER-ONLY representative Sample analysis Float32 PCM RAM budget.
# Explicit operational byte budget; empty keeps feature analysis disconnected.
IEUM_SAMPLE_ANALYSIS_MAX_PCM_BYTES=
